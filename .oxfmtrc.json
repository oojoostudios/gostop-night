{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 100,
  "ignorePatterns": [
    "node_modules/",
    "pnpm-lock.yaml",
    "package-lock.json",
    "yarn.lock",
    ".next/",
    "out/",
    "build/",
    "dist/",
    ".turbo/",
    ".cache/",
    ".eslintcache",
    "coverage/",
    "*.min.js",
    "*.min.css"
  ]
}
